# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
DB_PATH=./data/ars-store.sqlite
ADMIN_TOKEN=replace-with-another-long-random-secret

# Google OAuth: create a Web application OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Product display
PRODUCT_PRICE_BDT=350
PRODUCT_DURATION_MONTHS=18
SUPPORT_WHATSAPP_URL=

# Binance Pay credentials. Never put these values in public/ JavaScript.
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com

# Choose ONE payment mode.
# Fiat mode (only if your Binance Pay merchant account supports BDT):
BINANCE_PAY_FIAT_AMOUNT=350
BINANCE_PAY_FIAT_CURRENCY=BDT

# If BDT is not supported by your merchant profile, clear BOTH fiat values above
# and set the exact crypto amount/currency you intend to charge instead.
# Do not guess the conversion. Keep this aligned with the displayed product price.
BINANCE_PAY_ORDER_AMOUNT=
BINANCE_PAY_ORDER_CURRENCY=USDT
