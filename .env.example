# ARS Store — Railway environment variables
NODE_ENV=production
PORT=3000
APP_URL=https://YOUR-ARS-STORE-DOMAIN.up.railway.app
SESSION_SECRET=replace-with-a-long-random-secret
DB_PATH=/data/ars-store.sqlite
ADMIN_TOKEN=replace-with-another-long-random-secret

# Product display
PRODUCT_PRICE_BDT=350
PRODUCT_DURATION_MONTHS=18
SUPPORT_WHATSAPP_URL=https://wa.me/YOUR_FULL_INTERNATIONAL_NUMBER

# BDPayHub — use the public HTTPS origin only, no trailing path.
# Keep this URL reachable by both Railway server requests and customer browsers.
BDPAYHUB_BASE_URL=https://YOUR-PUBLIC-BDPAYHUB-DOMAIN
# Start in sandbox. Change to live only after device pairing and real-receipt testing.
BDPAYHUB_MODE=sandbox

# Use one API key per provider-specific BDPayHub Brand/Store.
# bKash Brand: default receiving account = bKash Personal account.
BDPAYHUB_BKASH_API_KEY=
BDPAYHUB_BKASH_WEBHOOK_SECRET=

# Nagad Brand: default receiving account = Nagad Personal account.
BDPAYHUB_NAGAD_API_KEY=
BDPAYHUB_NAGAD_WEBHOOK_SECRET=

# Never commit .env or paste API keys/webhook secrets into GitHub or screenshots.
